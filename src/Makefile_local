# Compiler
FC = nvfortran

# Compiler flags
FFLAGS = -fast -gpu=managed -cuda -acc -cudalib -Mfree -Mpreprocess -mcmodel=medium
#FFLAGS = -fast -gpu=managed -acc -cudalib 

# Executable name
EXEC = mhit36

# Source files
SRCS = module.f90 fib_param.f90 bspline.f90 mod_linspace.f90 mod_cosseratFun.f90 fibers.f90 \
       main.f90 readinput.f90 poissonfast.f90 readwrite.f90 particles.f90

# Fiber (Cosserat rod) sources: default REAL is double, as in FluTAS (-fdefault-real-8)
FIBOBJS = fib_param.o bspline.o mod_linspace.o mod_cosseratFun.o fibers.o
$(FIBOBJS): FFLAGS += -r8
# quad-precision rod solver as in FluTAS (about 8x slower on the CPU):
#$(FIBOBJS): FFLAGS += -r8 -DFIB_QUAD

# Libraries
LIBS    = -L/usr/local/cuda/lib64 -lcufft

# Object files
OBJS = $(SRCS:.f90=.o)

# Rule to compile .f90 files to .o files
%.o: %.f90
	$(FC) $(FFLAGS) $(LIBS)  -c $<

# Rule to link object files into executable
$(EXEC): $(OBJS)
	$(FC) $(FFLAGS) -o $@ $^

# Module dependencies
fib_param.o: fib_param.f90
bspline.o: bspline.f90
mod_linspace.o: fib_param.o
mod_cosseratFun.o: fib_param.o bspline.o
fibers.o: module.o fib_param.o bspline.o mod_linspace.o mod_cosseratFun.o
main.o: module.o fibers.o

# Clean rule
clean:
	rm -f $(OBJS) $(EXEC) *.mod
